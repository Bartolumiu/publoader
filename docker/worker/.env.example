# Publoader worker host configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# A worker needs exactly two things to start: a name and an enrollment token.
# Everything else has a working default.

# --- required ---------------------------------------------------------------

# How this host identifies itself to the operator. It shows up in
# `GET /api/v1/admin/workers`, in the audit log, and in whatever alert fires
# when a worker goes quiet — make it something you can act on.
WORKER_NAME=

# FIRST BOOT ONLY. Ask the operator for an enrollment token; they mint it with
#   curl -sX POST https://publoader.ardax.dev/api/v1/admin/enroll-tokens \
#        -H "Authorization: Bearer $ADMIN_TOKEN" \
#        -H 'content-type: application/json' \
#        -d '{"trust":"COMMUNITY","note":"<your host>","ttlHours":24}'
#
# It is single-use and expires. The agent trades it once for a permanent worker
# token, which it stores in the `worker-state` volume — after the first
# successful start you can blank this line. Deleting the volume means asking
# for a new enroll token.
ENROLL_TOKEN=

# --- optional ---------------------------------------------------------------

# The operator's control plane — this is the default and is correct for the
# public deployment; change it only if you were told to. Must be HTTPS: the
# worker token is a bearer credential sent on every request.
CORE_URL=https://publoader.ardax.dev

# Set INSTEAD of ENROLL_TOKEN only when re-attaching an identity the operator
# issued out of band, or restoring a worker whose state volume was lost.
# WORKER_TOKEN=

# The image this host runs. The default is the published release; override it
# only to pin an older version or a digest.
# PUBLOADER_WORKER_IMAGE=ardax/publoader-worker:2.1.3

# Resource ceilings for the container that runs third-party extension code.
# Raise the memory limit for image-heavy extensions; note /tmp is a 2g tmpfs
# and tmpfs usage counts against this limit.
# WORKER_MEM_LIMIT=2g
# WORKER_CPUS=2.0

# trace|debug|info|warn|error
# LOG_LEVEL=info

# Extra flags passed through to the extension runner. Diagnostics only.
# RUNNER_EXTRA_ARGS=
