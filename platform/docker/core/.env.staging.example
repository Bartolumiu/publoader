# ============================================================================
# STAGING core environment — copy to `.env.staging` and fill in.
#
#   cp docker/core/.env.staging.example docker/core/.env.staging
#   ./scripts/publoader staging up -d
#
# Staging is a full copy of the control plane with its OWN database volume,
# network and container names (PUBLOADER_ENV below drives the compose project
# name), so it can run beside production on the same host and can be destroyed
# with `./scripts/publoader staging down -v` without touching production.
#
# THE ONE RULE: staging must not be able to publish to real MangaDex. By
# default it points at a mock, and it boots PAUSED. Overriding either of those
# turns staging into a second production — do it deliberately, with a test
# MangaDex account, never with the production credentials.
# ============================================================================

# --- deployment identity ---------------------------------------------------
PUBLOADER_ENV=staging

# --- images (staging tracks `latest` on purpose — that is what it is for) ----
PUBLOADER_CORE_IMAGE=ardax/publoader-core:latest
PUBLOADER_MIGRATE_IMAGE=ardax/publoader-core-migrate:latest

# --- database (separate volume from production; see scripts/publoader) -------
POSTGRES_USER=publoader
POSTGRES_DB=publoader_staging
# Generate: openssl rand -base64 36
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://publoader:CHANGE_ME@postgres:5432/publoader_staging?schema=public&connection_limit=5

# --- admin API + dashboard -------------------------------------------------
# Distinct from production's. A staging credential must never open production.
ADMIN_TOKEN=
SESSION_SECRET=
SESSION_TTL_MINUTES=720
SESSION_COOKIE_SECURE=false
DASH_OWNER_EMAIL=iam@ardax.dev
# Staging is normally reached on loopback rather than a public hostname; if you
# do tunnel it, use a separate hostname (e.g. staging.publoader.ardax.dev) and
# register that redirect URI on a SEPARATE Discord OAuth app.
DASH_PUBLIC_URL=http://127.0.0.1:8100

# --- Discord OAuth (optional) ----------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- MangaDex: MOCK BY DEFAULT ---------------------------------------------
# Points at the dev mock (docker/dev/mock-md) so a staging run cannot touch the
# real catalogue. To exercise the real API, use a TEST MangaDex account and
# change these knowingly.
MANGADEX_API_URL=http://mock-md:8200
MANGADEX_AUTH_URL=http://mock-md:8200/realms/mangadex/protocol/openid-connect
MANGADEX_USERNAME=staging
MANGADEX_PASSWORD=staging
MANGADEX_CLIENT_ID=staging-client
MANGADEX_CLIENT_SECRET=staging-secret
# No artificial delay against a mock.
MANGADEX_RATELIMIT_MS=0
UPLOAD_RETRY=3

# --- notifications (leave blank so staging never posts to real channels) -----
DISCORD_WEBHOOK_URLS=

# --- Discord bot (usually off in staging) ----------------------------------
DISCORD_BOT_TOKEN=
BOT_API_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USERS=
DISCORD_ADMIN_ROLES=
DISCORD_ALLOWED_CHANNELS=

# --- ingress (no tunnel in staging by default) -----------------------------
TUNNEL_TOKEN=

# --- tuning: short timers so lease expiry and retries are observable --------
LOG_LEVEL=debug
LEASE_TTL_SECONDS=60
SWEEP_INTERVAL_SECONDS=10
SCHEDULER_INTERVAL_SECONDS=10
RETRY_BASE_SECONDS=10
RETRY_MAX_SECONDS=120
LEASE_POLL_WAIT_SECONDS=15

# --- ingress + optional services -------------------------------------------
# How the outside world reaches the dashboard/API:
#   tunnel  Cloudflare tunnel (cloudflared). No open ports, no public IP, no
#           certificates to manage. Requires TUNNEL_TOKEN.
#   direct  Caddy on 80/443 with a Let's Encrypt certificate it renews itself.
#           Requires a DNS A/AAAA record for PUBLOADER_HOSTNAME pointing at this
#           host, and inbound tcp/80 + tcp/443 open (80 is used for the ACME
#           challenge, so it is not optional). Set PUBLOADER_HOSTNAME + ACME_EMAIL.
#   none    Internal only: nothing is published. Reach it via an SSH tunnel.
PUBLOADER_INGRESS=none
PUBLOADER_HOSTNAME=staging.publoader.ardax.dev
ACME_EMAIL=
# Run the Discord bot alongside the core (needs DISCORD_BOT_TOKEN + BOT_API_TOKEN).
PUBLOADER_ENABLE_BOT=false
